# Copia este archivo como .env y llena tus datos. .env NO se sube a git.
DB_URL=jdbc:postgresql://<host-neon>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
DB_USER=neondb_owner
DB_PASSWORD=<password>
CORS_ORIGINS=http://localhost:5173
# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=<clave-secreta-larga>
JWT_EXPIRATION_MINUTES=480
